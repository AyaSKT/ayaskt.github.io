---
import { ClientRouter } from 'astro:transitions'
import { siteConfig } from '../config/site'
import '../styles/site.css'

interface Props {
  title?: string
  description?: string
  pageClass?: string
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  pageClass = '',
} = Astro.props
---

<!doctype html>
<html lang={siteConfig.lang} class={pageClass}>
  <head>
    <script is:inline>
      (() => {
        try {
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual'

          const root = document.documentElement
          const navEntry = performance.getEntriesByType?.('navigation')?.[0]
          const navType = navEntry?.type
          const key = `aya-scroll:${location.pathname}${location.search}`
          const saved = JSON.parse(sessionStorage.getItem(key) || 'null')

          if ((navType === 'reload' || navType === 'back_forward') && !location.hash && saved?.y > 1) {
            window.__ayaPendingScrollRestore = { x: saved.x || 0, y: saved.y || 0 }
            root.dataset.ayaScrollRestore = 'pending'
            root.style.visibility = 'hidden'
          }
        } catch {
          // Keep first paint visible if scroll state cannot be read.
        }

        const STORAGE_KEY = 'vitepress-theme-appearance'
        const root = document.documentElement
        const readPreference = () => {
          try {
            return localStorage.getItem(STORAGE_KEY) || 'auto'
          } catch {
            return 'auto'
          }
        }
        const prefersDark = () => window.matchMedia?.('(prefers-color-scheme: dark)').matches ?? false
        const preference = readPreference()
        const isDark = preference === 'dark' || (preference !== 'light' && prefersDark())
        root.classList.toggle('dark', isDark)
        root.style.colorScheme = isDark ? 'dark' : 'light'
      })()
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <script is:inline>
      (() => {
        if (!window.__ayaShellLifecycleSetup) {
          window.__ayaShellLifecycleSetup = true
          window.__ayaHasSpaNavigated = false

          const scrollKey = () => `aya-scroll:${location.pathname}${location.search}`
          const saveScroll = () => {
            try {
              sessionStorage.setItem(scrollKey(), JSON.stringify({
                x: window.scrollX,
                y: window.scrollY,
                t: Date.now(),
              }))
            } catch {
              // Ignore storage failures in private or restricted contexts.
            }
          }

          let saveScrollFrame = 0
          const scheduleSaveScroll = () => {
            if (saveScrollFrame) return
            saveScrollFrame = requestAnimationFrame(() => {
              saveScrollFrame = 0
              saveScroll()
            })
          }

          const revealAfterScrollRestore = () => {
            const root = document.documentElement
            delete root.dataset.ayaScrollRestore
            root.style.visibility = ''
            window.__ayaPendingScrollRestore = undefined
          }

          const restoreInitialScroll = () => {
            const pending = window.__ayaPendingScrollRestore
            if (!pending) return

            let attempts = 0
            const apply = () => {
              window.scrollTo(pending.x, pending.y)
              attempts += 1

              if (attempts < 4) {
                requestAnimationFrame(apply)
                return
              }

              setTimeout(() => {
                window.scrollTo(pending.x, pending.y)
                revealAfterScrollRestore()
                saveScroll()
              }, 0)
            }

            requestAnimationFrame(apply)
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', restoreInitialScroll, { once: true })
          } else {
            restoreInitialScroll()
          }

          setTimeout(() => {
            if (document.documentElement.dataset.ayaScrollRestore === 'pending') {
              const pending = window.__ayaPendingScrollRestore
              if (pending) window.scrollTo(pending.x, pending.y)
              revealAfterScrollRestore()
            }
          }, 900)

          window.addEventListener('scroll', scheduleSaveScroll, { passive: true })
          window.addEventListener('pagehide', saveScroll)
          window.addEventListener('beforeunload', saveScroll)
          document.addEventListener('astro:before-preparation', () => {
            window.__ayaHasSpaNavigated = true
            saveScroll()
          })
          document.addEventListener('astro:page-load', saveScroll)
        }

        if (window.__ayaAppearanceSetup) return
        window.__ayaAppearanceSetup = true

        const STORAGE_KEY = 'vitepress-theme-appearance'
        const root = document.documentElement
        const media = window.matchMedia('(prefers-color-scheme: dark)')

        const readPreference = () => {
          try {
            return localStorage.getItem(STORAGE_KEY) || 'auto'
          } catch {
            return 'auto'
          }
        }

        const writePreference = (preference) => {
          try {
            localStorage.setItem(STORAGE_KEY, preference)
          } catch {
            // Ignore storage failures in private or restricted contexts.
          }
        }

        const resolveDark = (preference) => preference === 'dark' || (preference !== 'light' && media.matches)

        const updateButtons = (isDark) => {
          document.querySelectorAll('.VPSwitchAppearance').forEach((button) => {
            button.setAttribute('aria-pressed', String(isDark))
            button.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode')
            button.setAttribute('title', isDark ? 'Switch to light mode' : 'Switch to dark mode')
          })
        }

        const applyPreference = (preference, { persist = false } = {}) => {
          if (persist) writePreference(preference)
          const isDark = resolveDark(preference)
          root.classList.toggle('dark', isDark)
          root.style.colorScheme = isDark ? 'dark' : 'light'
          updateButtons(isDark)
          return isDark
        }

        const canTransition = () => (
          'startViewTransition' in document &&
          window.matchMedia('(prefers-reduced-motion: no-preference)').matches
        )

        const appearanceCenter = (event) => {
          if (Number.isFinite(event.clientX) && Number.isFinite(event.clientY)) {
            return { x: event.clientX, y: event.clientY }
          }

          const switchEl = event.target?.closest?.('.VPSwitchAppearance')
            ?? document.querySelector('.VPNavBarAppearance .VPSwitchAppearance')

          if (switchEl instanceof HTMLElement) {
            const rect = switchEl.getBoundingClientRect()
            return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 }
          }

          return { x: window.innerWidth / 2, y: window.innerHeight / 2 }
        }

        const setPreference = async (preference, event) => {
          const nextDark = resolveDark(preference)

          if (!canTransition()) {
            applyPreference(preference, { persist: true })
            return
          }

          const { x, y } = appearanceCenter(event)
          const radius = Math.hypot(
            Math.max(x, innerWidth - x),
            Math.max(y, innerHeight - y),
          )
          const clipPath = [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${radius}px at ${x}px ${y}px)`,
          ]

          root.classList.add('vt-appearance')

          try {
            const transition = document.startViewTransition(() => {
              applyPreference(preference, { persist: true })
            })

            await transition.ready

            const animation = root.animate(
              { clipPath: nextDark ? clipPath.slice().reverse() : clipPath },
              {
                duration: 300,
                easing: 'ease-in',
                fill: 'forwards',
                pseudoElement: `::view-transition-${nextDark ? 'old' : 'new'}(root)`,
              },
            )

            await Promise.allSettled([transition.finished, animation.finished])
          } catch {
            applyPreference(preference, { persist: true })
          } finally {
            root.classList.remove('vt-appearance')
          }
        }

        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return

          const button = event.target.closest('.VPSwitchAppearance')
          if (!button) return

          event.preventDefault()
          setPreference(root.classList.contains('dark') ? 'light' : 'dark', event)
        })

        const syncAutoPreference = () => {
          if (readPreference() === 'auto') applyPreference('auto')
        }

        media.addEventListener?.('change', syncAutoPreference)
        media.addListener?.(syncAutoPreference)
        document.addEventListener('astro:before-swap', (event) => {
          const isDark = resolveDark(readPreference())
          const nextRoot = event.newDocument?.documentElement
          if (!nextRoot) return
          nextRoot.classList.toggle('dark', isDark)
          nextRoot.style.colorScheme = isDark ? 'dark' : 'light'
        })
        document.addEventListener('astro:after-swap', () => applyPreference(readPreference()))
        window.addEventListener('pageshow', () => applyPreference(readPreference()))
        document.addEventListener('astro:page-load', () => applyPreference(readPreference()))
        applyPreference(readPreference())
      })()
    </script>
  </body>
</html>
