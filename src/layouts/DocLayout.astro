---
import BaseLayout from './BaseLayout.astro'
import MarkdownContent from '../components/MarkdownContent.vue'
import NavBar from '../components/NavBar.astro'
import SidebarTree from '../components/SidebarTree.astro'
import { docsSpaces } from '../config/docs-spaces'
import type { LoadedDoc } from '../lib/content/docs'
import type { Heading } from '../lib/markdown/render'

interface Props {
  doc: LoadedDoc
  html: string
  headings: Heading[]
}

const { doc, html, headings } = Astro.props
const pageClass = ['doc', doc.frontmatter.pageClass, doc.frontmatter.layout === 'home' ? 'home' : ''].filter(Boolean).join(' ')
const showAside = doc.frontmatter.aside !== false && headings.some((heading) => heading.depth >= 2 && heading.depth <= 3)
const docsSpace = docsSpaces.find((space) => doc.urlPath.startsWith(space.base))
const sidebarTransitionName = docsSpace
  ? `sidebar-${docsSpace.base.replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '').toLowerCase()}`
  : 'sidebar-none'
---

<BaseLayout title={`${doc.title} | Ayaskt Workspace`} pageClass={pageClass}>
  <NavBar currentPath={doc.urlPath} />
  <div id="VPContent" class:list={['VPContent', { 'has-sidebar': Boolean(docsSpace) }]}> 
    <div class:list={['VPDoc', { 'has-sidebar': Boolean(docsSpace), 'has-aside': showAside }]}> 
      <aside class="VPSidebar" transition:name={sidebarTransitionName} transition:persist transition:animate="none">
        <nav class="nav" aria-label={docsSpace?.title ?? 'Sidebar navigation'}>
          <div class="sidebar-active-indicator" aria-hidden="true"></div>
          {docsSpace && <SidebarTree items={docsSpace.sidebar} currentPath={doc.urlPath} />}
        </nav>
      </aside>

      <div class="container">
        <div class="content">
          <div class="content-container">
            <main class="main" transition:name="doc-content">
              <MarkdownContent client:load html={html} path={doc.urlPath} frontmatter={doc.frontmatter} page={{ relativePath: doc.docsPath }} />
            </main>
          </div>
        </div>

        {showAside && (
          <aside class="aside">
            <div class="aside-curtain"></div>
            <div class="aside-container">
              <div class="aside-content">
                <nav class="VPDocAsideOutline has-outline" aria-labelledby="doc-outline-aria-label">
                  <div class="content">
                    <div class="outline-marker" aria-hidden="true"></div>
                    <div class="outline-title" id="doc-outline-aria-label" role="heading" aria-level="2">On this page</div>
                    <ul class="root">
                      {headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3).map((heading) => (
                        <li class={`outline-depth-${heading.depth}`}>
                          <a href={`#${heading.slug}`}>{heading.text}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </nav>
              </div>
            </div>
          </aside>
        )}
      </div>
    </div>
  </div>
  <script is:inline>
    (() => {
      if (window.__ayaDocRuntimeSetup) {
        window.__ayaSyncDocRuntime?.()
        return
      }
      window.__ayaDocRuntimeSetup = true

      const root = document.documentElement

      const normalize = (value) => {
        try {
          const url = new URL(value, window.location.href)
          const path = url.pathname.replace(/\/index\.html$/i, '/').replace(/\.html$/i, '')
          return path.length > 1 ? path.replace(/\/$/, '') : path
        } catch {
          return value
        }
      }

      const syncDocNavState = () => {
        root.classList.add('doc-nav-ready')
        root.classList.remove('doc-nav-animate')
      }

      const updateSidebarIndicator = () => {
        const nav = document.querySelector('.VPSidebar .nav')
        const indicator = nav?.querySelector('.sidebar-active-indicator')
        const activeLink = nav?.querySelector('.link[data-sidebar-current="true"]')

        if (!nav || !indicator || !activeLink) return

        const navRect = nav.getBoundingClientRect()
        const linkRect = activeLink.getBoundingClientRect()
        if (linkRect.width === 0 || linkRect.height === 0) {
          indicator.style.opacity = '0'
          return
        }

        indicator.style.opacity = '1'
        indicator.style.left = `${linkRect.left - navRect.left}px`
        indicator.style.top = `${linkRect.top - navRect.top}px`
        indicator.style.width = `${linkRect.width}px`
        indicator.style.height = `${linkRect.height}px`
      }

      const sidebarStorageKey = (id) => `aya-sidebar-collapsed:${id}`
      const sidebarTransitionHandlers = new WeakMap()
      const sidebarTransitionTimers = new WeakMap()

      const prefersReducedMotion = () => window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false

      const resetSidebarItemsAnimation = (items) => {
        if (!items) return
        items.classList.remove('is-collapsing', 'is-expanding')
        items.style.height = ''
        items.style.opacity = ''
        items.style.transform = ''
      }

      const finishSidebarItemsAnimation = (items, collapsed) => {
        const handler = sidebarTransitionHandlers.get(items)
        if (handler) items.removeEventListener('transitionend', handler)
        sidebarTransitionHandlers.delete(items)

        const timer = sidebarTransitionTimers.get(items)
        if (timer) window.clearTimeout(timer)
        sidebarTransitionTimers.delete(items)

        resetSidebarItemsAnimation(items)
        items.toggleAttribute('hidden', collapsed)
        requestAnimationFrame(updateSidebarIndicator)
      }

      const scheduleSidebarItemsFinish = (items, collapsed) => {
        const handler = (event) => {
          if (event.target === items && event.propertyName === 'height') {
            finishSidebarItemsAnimation(items, collapsed)
          }
        }
        sidebarTransitionHandlers.set(items, handler)
        items.addEventListener('transitionend', handler)
        sidebarTransitionTimers.set(items, window.setTimeout(() => {
          finishSidebarItemsAnimation(items, collapsed)
        }, 420))
      }

      const animateSidebarItems = (items, collapsed) => {
        if (!items || prefersReducedMotion()) {
          items?.toggleAttribute('hidden', collapsed)
          return
        }

        finishSidebarItemsAnimation(items, items.hidden)
        items.hidden = false

        if (collapsed) {
          const startHeight = items.scrollHeight
          items.style.height = `${startHeight}px`
          items.style.opacity = '1'
          items.style.transform = 'translateY(0)'
          items.classList.add('is-collapsing')
          items.offsetHeight
          scheduleSidebarItemsFinish(items, true)
          requestAnimationFrame(() => {
            items.style.height = '0px'
            items.style.opacity = '0'
            items.style.transform = 'translateY(-4px)'
          })
          return
        }

        items.style.height = '0px'
        items.style.opacity = '0'
        items.style.transform = 'translateY(-4px)'
        items.classList.add('is-expanding')
        items.offsetHeight
        const endHeight = items.scrollHeight
        scheduleSidebarItemsFinish(items, false)
        requestAnimationFrame(() => {
          items.style.height = `${endHeight}px`
          items.style.opacity = '1'
          items.style.transform = 'translateY(0)'
        })
      }

      const setSidebarGroupCollapsed = (group, collapsed, { persist = true, animate = false } = {}) => {
        const button = group.querySelector(':scope > .item > .sidebar-group-toggle')
        const items = group.querySelector(':scope > .items')
        group.classList.toggle('collapsed', collapsed)
        if (collapsed) {
          group.setAttribute('data-sidebar-collapsed', 'true')
        } else {
          group.removeAttribute('data-sidebar-collapsed')
        }
        button?.setAttribute('aria-expanded', String(!collapsed))

        if (animate) {
          animateSidebarItems(items, collapsed)
        } else if (items) {
          finishSidebarItemsAnimation(items, collapsed)
        }

        if (persist) {
          try {
            localStorage.setItem(sidebarStorageKey(group.dataset.sidebarGroupId), String(collapsed))
          } catch {
            // Ignore storage failures in private or restricted contexts.
          }
        }
      }

      const restoreSidebarCollapseState = () => {
        document.querySelectorAll('.VPSidebarItem[data-sidebar-group-id]').forEach((group) => {
          const activeInside = Boolean(group.querySelector('.link[data-sidebar-current="true"]'))
          let collapsed = group.getAttribute('data-sidebar-collapsed') === 'true'

          try {
            const saved = localStorage.getItem(sidebarStorageKey(group.dataset.sidebarGroupId))
            if (saved !== null) collapsed = saved === 'true'
          } catch {
            // Ignore storage failures in private or restricted contexts.
          }

          setSidebarGroupCollapsed(group, activeInside ? false : collapsed, { persist: false })
        })
      }

      const expandActiveSidebarParents = () => {
        const activeLink = document.querySelector('.VPSidebar .link[data-sidebar-current="true"]')
        if (!activeLink) return

        let group = activeLink.closest('.VPSidebarItem[data-sidebar-group-id]')
        while (group) {
          setSidebarGroupCollapsed(group, false)
          group = group.parentElement?.closest?.('.VPSidebarItem[data-sidebar-group-id]')
        }
      }

      const setupSidebarCollapse = () => {
        const nav = document.querySelector('.VPSidebar .nav')
        if (!nav || nav.dataset.sidebarCollapseBound === 'true') return
        nav.dataset.sidebarCollapseBound = 'true'

        nav.addEventListener('click', (event) => {
          const button = event.target instanceof Element
            ? event.target.closest('.sidebar-group-toggle')
            : undefined
          if (!button) return

          const group = button.closest('.VPSidebarItem[data-sidebar-group-id]')
          if (!group) return

          const nextCollapsed = group.getAttribute('data-sidebar-collapsed') !== 'true'
          setSidebarGroupCollapsed(group, nextCollapsed, { animate: true })
          requestAnimationFrame(updateSidebarIndicator)
        })
      }

      const syncCurrentLink = () => {
        const nav = document.querySelector('.VPSidebar .nav')
        if (!nav) return

        const currentPath = normalize(window.location.href)
        const links = nav.querySelectorAll('.link[href]')
        for (const link of links) {
          const isCurrent = normalize(link.href) === currentPath
          if (isCurrent) {
            link.setAttribute('data-sidebar-current', 'true')
            link.setAttribute('aria-current', 'page')
          } else {
            link.removeAttribute('data-sidebar-current')
            link.removeAttribute('aria-current')
          }
        }
        expandActiveSidebarParents()
        updateSidebarIndicator()
      }

      const updateOutlineMarker = () => {
        const outline = document.querySelector('.VPDocAsideOutline')
        const marker = outline?.querySelector('.outline-marker')
        const links = outline ? Array.from(outline.querySelectorAll('a[href^="#"]')) : []
        if (!outline || !marker || links.length === 0) return

        const headings = links
          .map((link) => {
            const target = document.getElementById(link.getAttribute('href').slice(1))
            return target ? { link, target } : undefined
          })
          .filter(Boolean)

        const active = [...headings].reverse().find(({ target }) => target.getBoundingClientRect().top <= 112) ?? headings[0]
        if (!active) return

        links.forEach((link) => link.toggleAttribute('data-outline-current', link === active.link))

        const content = outline.querySelector('.content')
        const contentRect = content.getBoundingClientRect()
        const linkRect = active.link.getBoundingClientRect()
        marker.style.opacity = '1'
        marker.style.top = `${linkRect.top - contentRect.top}px`
        marker.style.height = `${linkRect.height}px`
      }

      const syncDocRuntime = () => {
        if (!document.querySelector('.VPDoc')) {
          root.classList.remove('doc-nav-ready', 'doc-nav-animate')
          return
        }

        syncDocNavState()
        setupSidebarCollapse()
        restoreSidebarCollapseState()
        syncCurrentLink()
        requestAnimationFrame(updateOutlineMarker)
      }

      window.__ayaSyncDocRuntime = syncDocRuntime

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', syncDocRuntime, { once: true })
      } else {
        requestAnimationFrame(syncDocRuntime)
      }
      window.addEventListener('resize', updateSidebarIndicator, { passive: true })
      window.addEventListener('scroll', updateOutlineMarker, { passive: true })
      window.addEventListener('pageshow', syncDocRuntime)
      document.addEventListener('astro:page-load', syncDocRuntime)
    })()
  </script>
</BaseLayout>
