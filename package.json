{
  "name": "gp-blogs",
  "private": true,
  "scripts": {
    "docs:dev": "npm run fonts:download -- --offline && npm run docs:assets:local && vitepress dev docs",
    "docs:build": "npm run docs:assets && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:assets": "npm run fonts:download && npm run docs:assets:local",
    "docs:assets:local": "npm run docs:thumbs && npm run docs:previews && npm run timeline:covers",
    "docs:thumbs": "node scripts/generate-course-thumbnails.mjs",
    "docs:previews": "node scripts/generate-course-previews.mjs",
    "timeline:covers": "node scripts/generate-timeline-covers.mjs",
    "test:theme-components": "node --test scripts/theme-components.test.mjs",
    "test:course-index-assets": "node --test scripts/course-index-utils.test.mjs",
    "test:doc-meta-date": "node --test scripts/doc-meta-date.test.mjs",
    "test:reading-mode": "node --test scripts/reading-mode.test.mjs",
    "test:frosted-surface": "node --test scripts/frosted-surface.test.mjs",
    "test:local-editor": "node --test scripts/local-editor.test.mjs",
    "test:customization": "node --test scripts/customization.test.mjs",
    "test:pdf": "node --test scripts/verify-pdf-download.mjs",
    "postinstall": "node scripts/patch-mathjax.mjs",
    "fonts:download": "node scripts/download-fonts.mjs",
    "test:fonts": "node --test scripts/download-fonts.test.mjs"
  },
  "devDependencies": {
    "@mdit/plugin-mathjax": "^0.26.1",
    "@types/node": "^25.5.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "canvas-confetti": "^1.9.4",
    "katex": "^0.16.47",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "sharp": "^0.35.3",
    "vitepress": "^2.0.0-alpha.16",
    "vue": "^3.5.30",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@giscus/vue": "^3.1.1",
    "animate.css": "^4.1.1"
  }
}
