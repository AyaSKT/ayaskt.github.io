{
  "name": "gp-blogs",
  "private": true,
  "scripts": {
    "docs:dev": "npm run docs:assets && vitepress dev docs",
    "docs:build": "npm run docs:assets && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:assets": "npm run docs:thumbs && npm run docs:previews",
    "docs:thumbs": "node scripts/generate-course-thumbnails.mjs",
    "docs:previews": "node scripts/generate-course-previews.mjs",
    "test:course-index-assets": "node --test scripts/course-index-utils.test.mjs",
    "test:doc-meta-date": "node --test scripts/doc-meta-date.test.mjs",
    "test:pdf": "node --test scripts/verify-pdf-download.mjs",
    "postinstall": "node scripts/patch-mathjax.mjs"
  },
  "devDependencies": {
    "@mdit/plugin-mathjax": "^0.26.1",
    "@types/node": "^25.5.0",
    "canvas-confetti": "^1.9.4",
    "vitepress": "^2.0.0-alpha.16",
    "vue": "^3.5.30"
  },
  "dependencies": {
    "@giscus/vue": "^3.1.1",
    "animate.css": "^4.1.1"
  }
}
